# Languages supported by LibreTranslate / Argos (base codes only)
LIBRE_LANGS = {"ar","az","zh","cs","da","nl","en","fi","fr","de",
               "el","he","hi","hu","id","ga","it","ja","ko","fa",
               "pl","pt","ru","sk","es","sv","tl","tr","uk","vi"}

_PRESERVE_RE = re.compile(r"\{[^}]*\}|%[sdif]|<[^>]+>|&[a-z]+;|&#\d+;")

HEADER_ALIASES = {
    "user_language":         ["user language","userlanguage","language","locale","lang"],
    "base_value":            ["base value","basevalue","source value","source","english value","base"],
    "rich_base_value":       ["rich base value","richbasevalue","rich base","rich source","rich value base"],
    "translated_value":      ["translated value","translatedvalue","translation","translated","target value"],
    "translated_rich_value": ["translated rich value","translatedrichvalue","rich translated",
                              "rich translation","translated rich","rich target"],
    "status":                ["status","translation status","translationstatus","state"],
}

_SEP      = "\n⦙⦙SEP⦙⦙\n"
MAX_CHARS = 4000

ENGINES = {
    "Google Translate":  "google",
    "LibreTranslate (self-hosted, private)": "libre",
