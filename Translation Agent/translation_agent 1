if not uploaded:
    st.markdown(
        "<p style='text-align:center;color:#888;margin-top:0.5rem'>"
        "Supported: .xlsx with User Language, Base Value, and Translated Value columns</p>",
        unsafe_allow_html=True,
    )
else:
    file_bytes_peek = uploaded.read()
    uploaded.seek(0)
    info = scan_file(file_bytes_peek)

    st.success(
        f"**{uploaded.name}** &nbsp;·&nbsp; {uploaded.size / 1024:.1f} KB"
        f" &nbsp;·&nbsp; {info['row_count']} rows"
        f" &nbsp;·&nbsp; {info['lang_count']} language(s)"
        f" &nbsp;·&nbsp; {info['unique_text_count']} unique strings"
    )

    # Warn if engine can't handle some languages
    if engine in ("libre", "argos"):
        wb_prev = openpyxl.load_workbook(io.BytesIO(file_bytes_peek), read_only=True, data_only=True)
        detected_langs = set()
        for sn in wb_prev.sheetnames:
            ws = wb_prev[sn]
            hr, cm = find_header_row(ws)
            if hr and "user_language" in cm:
                for row in ws.iter_rows(min_row=hr+1, values_only=True):
                    lv = row[cm["user_language"] - 1] if cm["user_language"] - 1 < len(row) else None
                    if lv:
                        b = _base_lang(str(lv).strip())
                        if b and b != "en":
                            detected_langs.add(b)
        wb_prev.close()
        unsupported = detected_langs - LIBRE_LANGS
        if unsupported:
            st.markdown(
                f'<div class="warn-box">⚠️ <b>Unsupported languages detected:</b> '
                f'<code>{", ".join(sorted(unsupported))}</code> — '
                f'these are not available in {engine_label.split(" ")[0]}. '
                f'Those rows will be left untranslated.</div>',
                unsafe_allow_html=True,
            )

    st.markdown(
        f"""<div class="eta-box">
        ⏳ <b>Estimated time: ~{fmt_time(info['eta_seconds'])}</b>
        &nbsp;&nbsp;|&nbsp;&nbsp;
        {info['request_count']} request(s)
        &nbsp;·&nbsp; {info['unique_text_count']} unique strings
        &nbsp;·&nbsp; Engine: <b>{engine_label.split(" ")[0]}</b>
        </div>""",
        unsafe_allow_html=True,
    )

    # Block LibreTranslate if server is down
    libre_ok = True
    if engine == "libre":
        running, _ = _check_libre(libre_url)
        if not running:
            st.error("Cannot translate — LibreTranslate server is not running. See setup instructions above.")
            libre_ok = False

    if libre_ok and st.button("🚀 Translate", type="primary", use_container_width=True):
        file_bytes   = uploaded.read()
        progress_ph  = st.empty()
        timer_text   = st.empty()
        status_text  = st.empty()
        render_progress(progress_ph, 0)

        try:
            out_bytes, total, sheet_stats, elapsed = translate_workbook(
                file_bytes, progress_ph, status_text, timer_text,
                info, engine, libre_url,
            )
            render_progress(progress_ph, 1.0)
            status_text.empty(); timer_text.empty()

            st.markdown(
                f"""<div class="done-box">
                ✅ <b>Translation complete</b>
                &nbsp;&nbsp;|&nbsp;&nbsp;
                ⏱ Took <b>{fmt_time(elapsed)}</b>
                &nbsp;&nbsp;|&nbsp;&nbsp;
                📋 {total} rows &nbsp;·&nbsp; Engine: {engine_label.split(" ")[0]}
                </div>""",
                unsafe_allow_html=True,
            )

            items = [("⏱", fmt_time(elapsed), "Time taken"),
                     ("📋", str(total),        "Rows translated"),
                     ("🔧", engine_label.split()[0], "Engine")]
            items += [("📄", str(c), name) for name, c in sheet_stats]

            cols = st.columns(len(items))
            for col, (icon, val, lbl) in zip(cols, items):
                col.markdown(
                    f'<div class="metric-box"><div class="val">{icon} {val}</div>'
                    f'<div class="lbl">{lbl}</div></div>',
                    unsafe_allow_html=True,
                )

            st.markdown("<br>", unsafe_allow_html=True)
            out_name = uploaded.name.replace(".xlsx", f"_Translated_{engine_label.split()[0]}.xlsx")
            st.download_button(
                label="⬇️ Download Translated File",
                data=out_bytes,
                file_name=out_name,
                mime="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
                use_container_width=True,
                type="primary",
            )

        except Exception as e:
            progress_ph.empty(); status_text.empty(); timer_text.empty()
            st.error(f"Error: {e}")
