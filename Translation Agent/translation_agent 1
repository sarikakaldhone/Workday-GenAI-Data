# ══════════════════════════════════════════════════════════════════════════════
# Helpers
# ══════════════════════════════════════════════════════════════════════════════

def _norm(t):
    return re.sub(r"[^a-z0-9]", " ", str(t).lower()).strip()

def _protect(text):
    tokens = {}
    def sub(m):
        k = f"__P{len(tokens)}__"
        tokens[k] = m.group(0)
        return k
    return _PRESERVE_RE.sub(sub, text), tokens

def _restore(text, tokens):
    for k, v in tokens.items():
        text = text.replace(k, v)
    return text

def fmt_time(s):
    s = max(int(s), 0)
    return f"{s//60}m {s%60}s" if s >= 60 else f"{s}s"

def render_progress(ph, pct):
    pct = min(max(pct, 0.0), 1.0)
    p = int(pct * 100)
    w = max(p, 4)
    label = f"{p}%" if p > 8 else ""
    ph.markdown(
        f'<div class="progress-track"><div class="progress-fill" style="width:{w}%">{label}</div></div>',
        unsafe_allow_html=True,
    )

def find_header_row(ws, max_scan=20):
    best_row, best_map, best_score = None, {}, 0
    for ri in range(1, min(max_scan + 1, ws.max_row + 1)):
        vals = [ws.cell(row=ri, column=c).value for c in range(1, ws.max_column + 1)]
        col_map, score = {}, 0
        for ci, v in enumerate(vals, 1):
            if v is None:
                continue
            n = _norm(v)
            for key, aliases in HEADER_ALIASES.items():
                if key not in col_map and any(a in n or n in a for a in aliases):
                    col_map[key] = ci; score += 1; break
        if score > best_score:
            best_score, best_row, best_map = score, ri, col_map
    return (best_row, best_map) if best_score >= 2 else (None, {})

def copy_style(src, dst):
    try:
        if src.has_style:
            dst.font = copy(src.font); dst.fill = copy(src.fill)
            dst.border = copy(src.border); dst.alignment = copy(src.alignment)
    except Exception:
        pass

def _base_lang(locale: str) -> str:
    """Return base language code from a BCP-47 locale string."""
    gl = LOCALE_MAP.get(locale.lower().strip(), "")
    # strip region suffix for Argos/Libre (e.g. zh-CN → zh)
    return gl.split("-")[0].lower() if gl else ""


# ══════════════════════════════════════════════════════════════════════════════
# Translation engines
# ══════════════════════════════════════════════════════════════════════════════

# ── Google Translate ───────────────────────────────────────────────────────────

def _google_translate_chunks(unique_texts: list, google_lang: str) -> dict:
    cache = {}
    protected_items = []
    for text in unique_texts:
        if not text or not str(text).strip():
            cache[text] = text; continue
        p, tokens = _protect(str(text))
        protected_items.append((text, p, tokens))

    chunks, cur, cur_len = [], [], 0
    for item in protected_items:
        il = len(item[1]) + len(_SEP)
        if cur and cur_len + il > MAX_CHARS:
            chunks.append(cur); cur, cur_len = [item], il
        else:
            cur.append(item); cur_len += il
    if cur:
        chunks.append(cur)

    for chunk in chunks:
        combined = _SEP.join(p for _, p, _ in chunk)
        try:
            translated = GoogleTranslator(source="auto", target=google_lang).translate(combined)
            parts = translated.split(_SEP)
            if len(parts) == len(chunk):
                for (orig, _, tokens), trans in zip(chunk, parts):
                    cache[orig] = _restore(trans.strip(), tokens)
            else:
                for orig, prot, tokens in chunk:
                    try:
                        t = GoogleTranslator(source="auto", target=google_lang).translate(prot)
                        cache[orig] = _restore(t or orig, tokens)
                    except Exception:
                        cache[orig] = orig
        except Exception:
            for orig, _, _ in chunk:
                cache[orig] = orig
    return cache


# ── LibreTranslate ─────────────────────────────────────────────────────────────

def _libre_translate_chunks(unique_texts: list, target_lang: str, libre_url: str) -> dict:
    """Translate via a local LibreTranslate server. One POST per text (no separator trick needed — API is local)."""
    cache = {}
    for text in unique_texts:
        if not text or not str(text).strip():
            cache[text] = text; continue
        prot, tokens = _protect(str(text))
        try:
            resp = _requests.post(
                f"{libre_url.rstrip('/')}/translate",
                json={"q": prot, "source": "en", "target": target_lang, "format": "text"},
                timeout=15,
            )
            resp.raise_for_status()
            translated = resp.json().get("translatedText", prot)
            cache[text] = _restore(translated, tokens)
        except Exception:
            cache[text] = text
    return cache


def _check_libre(url: str) -> tuple[bool, str]:
    """Returns (is_running, languages_list_or_error)."""
    try:
        r = _requests.get(f"{url.rstrip('/')}/languages", timeout=5)
        r.raise_for_status()
        langs = [l["code"] for l in r.json()]
        return True, langs
    except Exception as e:
        return False, str(e)


# ── Argos Translate ────────────────────────────────────────────────────────────

@st.cache_resource(show_spinner=False)
def _load_argos():
    """Install argostranslate if needed and return the module."""
    if not importlib.util.find_spec("argostranslate"):
        subprocess.check_call([sys.executable, "-m", "pip", "install",
                               "argostranslate", "--quiet"])
    import argostranslate.package
    import argostranslate.translate
    return argostranslate


def _ensure_argos_package(from_code: str, to_code: str, argos) -> bool:
    """Download Argos language package if not already installed. Returns success."""
    try:
        argos.package.update_package_index()
        available = argos.package.get_available_packages()
        pkg = next(
            (p for p in available if p.from_code == from_code and p.to_code == to_code),
            None,
        )
        if pkg:
            installed = argos.package.get_installed_packages()
            already = any(p.from_code == from_code and p.to_code == to_code for p in installed)
            if not already:
                argos.package.install_from_path(pkg.download())
        return True
    except Exception:
        return False


def _argos_translate_texts(unique_texts: list, target_lang: str) -> dict:
    cache = {}
    argos = _load_argos()
    _ensure_argos_package("en", target_lang, argos)
    for text in unique_texts:
        if not text or not str(text).strip():
            cache[text] = text; continue
        prot, tokens = _protect(str(text))
        try:
            result = argos.translate.translate(prot, "en", target_lang)
            cache[text] = _restore(result, tokens)
        except Exception:
            cache[text] = text
    return cache


# ── Unified dispatcher ─────────────────────────────────────────────────────────

def translate_unique_texts(unique_texts: list, locale: str, engine: str,
                            libre_url: str = "http://localhost:5000") -> dict:
    if not unique_texts:
        return {}

    base = _base_lang(locale)
    google_lang = LOCALE_MAP.get(locale.lower().strip(), "")

    if engine == "google":
        if not google_lang or google_lang == "en":
            return {t: t for t in unique_texts}
        return _google_translate_chunks(unique_texts, google_lang)

    elif engine == "libre":
        if not base or base == "en" or base not in LIBRE_LANGS:
            return {t: t for t in unique_texts}
        return _libre_translate_chunks(unique_texts, base, libre_url)

    elif engine == "argos":
        if not base or base == "en" or base not in LIBRE_LANGS:
            return {t: t for t in unique_texts}
        return _argos_translate_texts(unique_texts, base)

    return {t: t for t in unique_texts}


# ══════════════════════════════════════════════════════════════════════════════
# File scan
# ══════════════════════════════════════════════════════════════════════════════

def scan_file(file_bytes: bytes) -> dict:
    try:
        wb = openpyxl.load_workbook(io.BytesIO(file_bytes), read_only=True, data_only=True)
        row_count, langs, lang_texts = 0, set(), defaultdict(set)

        for sheet_name in wb.sheetnames:
            ws = wb[sheet_name]
            header_row, col_map = find_header_row(ws)
            if header_row is None or "base_value" not in col_map:
                continue
            last_lang = ""
            for row in ws.iter_rows(min_row=header_row + 1, values_only=True):
                lv = row[col_map["user_language"] - 1] if col_map["user_language"] - 1 < len(row) else None
                lang = str(lv).strip() if lv else ""
                if lang: last_lang = lang
                else:    lang = last_lang
                bv = row[col_map["base_value"] - 1] if col_map["base_value"] - 1 < len(row) else None
                rv_col = col_map.get("rich_base_value", 0)
                rv = row[rv_col - 1] if rv_col and rv_col - 1 < len(row) else None
                if not lang and not bv:
                    continue
                row_count += 1
                gl = LOCALE_MAP.get(lang.lower().strip(), "")
                if gl and gl != "en":
                    langs.add(lang)
                    if bv and str(bv).strip(): lang_texts[gl].add(str(bv).strip())
                    if rv and str(rv).strip(): lang_texts[gl].add(str(rv).strip())

        wb.close()
        total_req = sum(max(1, -(-sum(len(t) + len(_SEP) for t in texts) // MAX_CHARS))
                        for texts in lang_texts.values())
        return {
            "row_count": row_count,
            "lang_count": len(langs),
            "unique_text_count": sum(len(v) for v in lang_texts.values()),
            "request_count": total_req,
            "eta_seconds": max(total_req * 2 + 1, 2),
        }
    except Exception:
        return {"row_count": 0, "lang_count": 0, "unique_text_count": 0,
                "request_count": 1, "eta_seconds": 5}


# ══════════════════════════════════════════════════════════════════════════════
# Core workbook processor
# ══════════════════════════════════════════════════════════════════════════════

def translate_workbook(file_bytes, progress_ph, status_text, timer_text,
                       scan_info, engine, libre_url):
    wb = openpyxl.load_workbook(io.BytesIO(file_bytes))
    t_start       = time.time()
    total_req     = max(scan_info["request_count"], 1)
    done_req      = [0]
    total_done    = 0
    sheet_stats   = []

    def _tick(extra=""):
        elapsed   = time.time() - t_start
        pct       = done_req[0] / total_req
        remaining = (elapsed / pct - elapsed) if pct > 0 else scan_info["eta_seconds"]
        timer_text.markdown(
            f"⏱ **Elapsed:** {fmt_time(elapsed)} &nbsp;&nbsp; ⏳ **Remaining:** ~{fmt_time(remaining)}"
            + (f" &nbsp;&nbsp; {extra}" if extra else "")
        )

    for sheet_name in wb.sheetnames:
        ws = wb[sheet_name]
        header_row, col_map = find_header_row(ws)
        if header_row is None or "base_value" not in col_map:
            continue
        if any(k not in col_map for k in ["user_language", "translated_value"]):
            continue

        last_lang = ""
        rows = []
        for ri in range(header_row + 1, ws.max_row + 1):
            lc   = ws.cell(row=ri, column=col_map["user_language"])
            lang = str(lc.value).strip() if lc.value else ""
            if lang: last_lang = lang
            else:    lang = last_lang
            base = ws.cell(row=ri, column=col_map["base_value"]).value
            rich = ws.cell(row=ri, column=col_map["rich_base_value"]).value \
                   if "rich_base_value" in col_map else None
            if not lang and not base:
                continue
            rows.append({"row_idx": ri, "lang": lang,
                         "base": str(base) if base else "",
                         "rich": str(rich) if rich else ""})

        if not rows:
            continue

        lang_groups = defaultdict(list)
        for r in rows:
            lang_groups[r["lang"]].append(r)

        for lang, group in lang_groups.items():
            unique_texts = list({t for r in group
                                  for t in (r["base"], r["rich"]) if t and t.strip()})
            chars    = sum(len(t) + len(_SEP) for t in unique_texts)
            n_chunks = max(1, -(-chars // MAX_CHARS))

            status_text.markdown(
                f"🔄 **{sheet_name}** — `{lang}` "
                f"| {len(group)} rows | {len(unique_texts)} unique strings"
            )
            _tick()

            cache = translate_unique_texts(unique_texts, lang, engine, libre_url)

            done_req[0] += n_chunks
            render_progress(progress_ph, done_req[0] / total_req)
            _tick(f"✅ `{lang}` done")

            for r in group:
                r["tv"]  = cache.get(r["base"], r["base"])
                r["trv"] = cache.get(r["rich"], r["rich"])

        count = 0
        for r in rows:
            ri  = r["row_idx"]
            src = ws.cell(row=ri, column=col_map["base_value"])

            tc = ws.cell(row=ri, column=col_map["translated_value"])
            copy_style(src, tc); tc.value = r.get("tv", r["base"])

            if "translated_rich_value" in col_map:
                rc = ws.cell(row=ri, column=col_map["translated_rich_value"])
                copy_style(src, rc); rc.value = r.get("trv", r["rich"])

            if "status" in col_map:
                ws.cell(row=ri, column=col_map["status"]).value = "Done"
            count += 1

        total_done  += count
        sheet_stats.append((sheet_name, count))

    out = io.BytesIO()
    wb.save(out)
    return out.getvalue(), total_done, sheet_stats, time.time() - t_start


